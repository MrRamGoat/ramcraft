# Copy to .env and edit. docker compose reads .env automatically.
# .env is gitignored - keep your real values there, not in the compose file.

# The LAN address of the machine running RamCraft. Shown as the direct
# join address on every world card.
RAMCRAFT_LAN_HOST=192.168.1.10

# Worlds are published as <name>.<this>. Point a wildcard DNS record
# (*.mc.example.com) at your public IP and forward TCP 25565 once; every
# world you create after that is reachable with no further setup.
# Leave blank to use LAN addresses only.
RAMCRAFT_ROUTER_DOMAIN=mc.example.com

# How much RAM this machine may hand out, in GB. /proc/meminfo reports the
# hypervisor's RAM inside a container or LXC, so this has to be explicit.
RAMCRAFT_MEM_BUDGET_GB=16

# Port 25565 belongs to mc-router; per-world direct ports come from this range.
RAMCRAFT_PORT_BASE=25566
RAMCRAFT_PORT_MAX=25640

# The gid that owns /var/run/docker.sock. mc-router runs as a non-root user
# and cannot read the socket without it:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=988

TZ=Etc/UTC
